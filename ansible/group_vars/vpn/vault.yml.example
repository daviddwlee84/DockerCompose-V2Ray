---
# SINGLE-HOST LAYOUT (this file): copy to vault.yml, fill in real values, then
# encrypt with `ansible-vault encrypt ansible/group_vars/vpn/vault.yml`.
# After encryption, edit via `ansible-vault edit ansible/group_vars/vpn/vault.yml`.
#
# MULTI-HOST LAYOUT (preferred when using the Azure throwaway flow): each VM
# has its own encrypted vault at ansible/host_vars/<host>/vault.yml with its
# own vault_domain / vault_v2ray_uuid. `just az-configure` writes these
# automatically from .secrets/azure/vms/*.json. Ansible's variable
# precedence (host_vars > group_vars) means you can leave this file empty
# if every host has its own per-host vault.
#
# Migration hint: once you've moved fully to multi-host, it's OK (and
# recommended) to delete or archive this group vault — otherwise Ansible
# still does one redundant decryption per `just deploy`. See
# docs/MULTI-HOST.md "Migration note".
#
# Vault password file: ~/.vault-pass (gitignored, chmod 600).

vault_domain: your-dns-name.japaneast.cloudapp.azure.com
vault_letsencrypt_email: you@example.com
vault_v2ray_uuid: "00000000-0000-0000-0000-000000000000"  # generate with: uuidgen

# REALITY key material — required when vpn_protocol is `reality` or `both`
# (the default is `reality`). Generate all three with:
#
#   scripts/reality_keys.py
#
# vault_v2ray_uuid doubles as the VLESS client id; there is no separate UUID.
# The private key must NEVER leave the vault. The public key + short ID are
# handed to clients, and are kept here only so client_config.py can emit a
# complete config from a single vault decryption.
vault_reality_private_key: "replace-me"
vault_reality_public_key: "replace-me"
vault_reality_short_id: "0123abcd"

# Only needed if you set monitoring_enabled: true (see docs/OBSERVABILITY.md).
# Must match obs_ingest_user / obs_ingest_password on the [observability] host.
# vault_obs_ingest_user: "vpn-agent"
# vault_obs_ingest_password: "change-me-shared-ingest-secret"
