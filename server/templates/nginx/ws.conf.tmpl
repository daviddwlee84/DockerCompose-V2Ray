# LEGACY listener — only rendered when vpn_protocol is vmess_ws or both.
# The default `reality` mode uses landing.conf.tmpl instead and has no TLS
# terminating nginx at all.
#
# Port shown as 443 (vmess_ws mode). In `both` mode this listens on
# ${VMESS_WS_PORT} instead, because 443 belongs to Xray/REALITY there.
server{
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
       root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2 default_server;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;


    root /usr/share/nginx/html/v2ray;
    index index.html;

    location ${V2RAY_WS_PATH} {
        proxy_redirect off;
        proxy_pass http://xray:30909;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;

        # Keep long-lived / idle WebSocket tunnels alive. nginx's default
        # proxy_read_timeout is 60s, which severs any tunnel with no upstream
        # data for 60s — e.g. an LLM streaming response that pauses while the
        # model "thinks", or an idle SSH-over-proxy session → the client sees
        # "other side closed" at ~60s. Raise well above interactive gaps.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
